# Copiá este archivo a .env y completalo. NUNCA lo subas al repo.
# Ojo: las variables de env_file son visibles con `docker inspect` para quien
# tenga acceso al daemon de Docker (ver docs/secretos.md para alternativas).

# --- Intervals.icu (obligatorio) ---------------------------------------------
# Intervals.icu > Settings > Developer Settings > API Key
INTERVALS_ICU_API_KEY=
# Formato i123456 (aparece en Settings, o en la URL de tu perfil)
INTERVALS_ICU_ATHLETE_ID=

# --- Telegram (obligatorio) --------------------------------------------------
# Token que te da @BotFather al crear el bot (formato 123456789:AAH...)
TELEGRAM_BOT_TOKEN=
# Tu ID numérico de usuario (escribile a @userinfobot). Es el único que puede
# hablar con el bot y a quien se le mandan los avisos.
TELEGRAM_USER_ID=

# --- Claude Code (suscripción) ------------------------------------------------
# Opción A (recomendada): token de larga duración (1 año). Generalo con
#   claude setup-token
# (en tu máquina, o con scripts/setup.sh) y pegalo acá.
# Opción B: dejalo vacío y hacé login dentro del contenedor (scripts/setup.sh);
# las credenciales quedan en el volumen 'claude'.
CLAUDE_CODE_OAUTH_TOKEN=

# --- Opcionales ---------------------------------------------------------------
# Modelo de Claude: haiku (el que menos cuota consume), sonnet u opus (más capaz,
# consume la cuota más rápido). También acepta un ID completo, ej. claude-sonnet-5.
CLAUDE_MODEL=haiku
TZ=America/Argentina/Tucuman
# Hora (HH:MM, según TZ) del reinicio diario de la sesión para limpiar contexto
DAILY_RESTART_TIME=04:00
# Memoria persistente: el asistente recuerda objetivos, lesiones y preferencias que
# le digas por Telegram (volumen 'memoria'; ver con scripts/memoria.sh ver).
MEMORIA_ENABLED=true

# --- Tareas programadas (servicio `tareas`) -----------------------------------------
# Usan CLAUDE_MODEL (o TAREAS_MODEL si lo definís), no el modelo elegido con /modelo.
# Necesitan CLAUDE_CODE_OAUTH_TOKEN (sin él, solo corren las alertas y el chequeo).
TAREAS_MODEL=
# Resumen matinal: sueño, FC en reposo, forma, ayer, plan de hoy y recomendación
MORNING_ENABLED=true
MORNING_TIME=07:00
# Análisis de cada actividad nueva (revisa cada N minutos sin gastar tokens; espera
# POST_ACTIVITY_DELAY_MIN para que lleguen Edge y reloj; ignora actividades que
# empezaron hace más de POST_ACTIVITY_MAX_AGE_H horas, p. ej. importaciones viejas)
POST_ACTIVITY_ENABLED=true
POST_ACTIVITY_EVERY_MIN=15
POST_ACTIVITY_DELAY_MIN=10
POST_ACTIVITY_MAX_AGE_H=36
# Alertas de recuperación (sin tokens): FC reposo +N lpm sobre el promedio de 14 días,
# HRV N % por debajo (si el reloj la reporta) o TSB por debajo del mínimo
ALERTS_ENABLED=true
ALERTS_TIME=10:00
ALERT_RHR_DELTA=5
ALERT_HRV_DROP_PCT=20
ALERT_TSB_MIN=-30
# Resumen semanal (WEEKLY_DAY: 0=domingo ... 6=sábado)
WEEKLY_ENABLED=true
WEEKLY_DAY=0
WEEKLY_TIME=20:00
# Chequeo diario de la API de Intervals.icu; avisa por Telegram si falla
MONITOR_ENABLED=true
CHECK_TIME=08:00

# Espera (ms) al arranque de cada servidor MCP. Subilo si en `claude mcp list` aparece
# "connection timed out" (típico en equipos con disco lento, como algunos LXC/VM).
MCP_TIMEOUT=120000

# --- Límites de recursos (opcionales) -------------------------------------------------
# Topes por contenedor. Docker rechaza un CPU mayor que los núcleos del host (por ejemplo,
# en un LXC de 1 núcleo, 1.0 es el máximo).
CANAL_CPUS=1.0
CANAL_MEM=1g
TAREAS_CPUS=1.0
TAREAS_MEM=768m
